{
    admin off
    persist_config off
    default_sni {$CADDY_DEFAULT_SNI:localhost}
}

(supets_headers) {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(self)"
        -Server
    }
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri delete
                resp_headers delete
            }
        }
    }
}

(supets_webhook) {
    @enabled_webhook {
        path /github-webhook/
        method POST
        expression {$JENKINS_WEBHOOK_ENABLED:false}
    }
    handle @enabled_webhook {
        request_body {
            max_size 64KiB
        }
        reverse_proxy jenkins:8080 {
            header_up -X-SuPets-Client-IP
            header_up X-SuPets-Client-IP {remote_host}
            transport http {
                dial_timeout 2s
                response_header_timeout 15s
            }
        }
    }
}

(supets_errors) {
    handle_errors {
        @too_large expression {err.status_code} == 413
        handle @too_large {
            header Content-Type application/json
            respond `{"message":"O corpo da requisição excede o limite de 64 KiB."}` 413
        }
        handle {
            header Content-Type application/json
            respond `{"message":"Não foi possível atender à solicitação."}` {err.status_code}
        }
    }
}

:8085 {
    respond /health "OK" 200
    respond 404
}
