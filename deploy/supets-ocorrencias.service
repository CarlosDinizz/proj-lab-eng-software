[Unit]
Description=SuPets - ocorrencias (porta 8082)
After=network.target docker.service

[Service]
User=jenkins
WorkingDirectory=/opt/supets
EnvironmentFile=/etc/supets/supets.env
ExecStart=/usr/bin/java -Xmx384m -jar /opt/supets/ocorrencias.jar
SuccessExitStatus=143
Restart=on-failure

[Install]
WantedBy=multi-user.target
