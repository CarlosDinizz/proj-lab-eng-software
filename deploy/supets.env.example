# Referência pública; o launcher gera valores reais no volume privado de controle.
# Não copie este exemplo sobre um projeto inicializado nem altere senhas só aqui.
# Não é necessário editar variáveis para executar `supets up`.
COMMUNITY_DB_ADMIN_PASSWORD=
COMMUNITY_DB_PASSWORD=
OCORRENCIAS_DB_ADMIN_PASSWORD=
OCORRENCIAS_DB_PASSWORD=
JWT_SECRET=
# Local: http://:8080. Cloud: definido por --cloud --ip <IPv4 público>.
SITE_ADDRESS=
ACME_EMAIL=
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
WEB_MODE=maintenance
JENKINS_WEBHOOK_ENABLED=false
