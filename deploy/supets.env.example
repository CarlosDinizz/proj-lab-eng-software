# Copie para /etc/supets/supets.env (o setup-servidor.sh já faz isso e gera valores aleatórios).
# Lido pelos serviços systemd, pelo docker-compose dos bancos e pelo Jenkins (testes do community).
PG_USER=supets
PG_PASSWORD=troque-esta-senha
# Mínimo de 32 caracteres. Tem que ser o mesmo valor no gateway e no community (os dois leem este arquivo).
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
