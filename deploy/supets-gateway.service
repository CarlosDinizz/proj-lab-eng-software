[Unit]
Description=SuPets - gateway (porta 8081)
After=network.target docker.service

[Service]
User=jenkins
WorkingDirectory=/opt/supets
EnvironmentFile=/etc/supets/supets.env
Environment=COMMUNITY_URL=http://localhost:8083
Environment=OCORRENCIAS_URL=http://localhost:8082
ExecStart=/usr/bin/java -Xmx384m -jar /opt/supets/gateway.jar
SuccessExitStatus=143
Restart=on-failure

[Install]
WantedBy=multi-user.target
